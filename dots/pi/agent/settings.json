{
  "lastChangelogVersion": "1.0.0",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-astra",
  "defaultThinkingLevel": "high",
  "hideThinkingBlock": false,
  "steeringMode": "one-at-a-time",
  "transport": "sse",
  "followUpMode": "one-at-a-time",
  "doubleEscapeAction": "tree",
  "packages": [
    {
      "source": "git:github.com/tmustier/pi-extensions",
      "extensions": ["files-widget/index.ts"]
    },
    "git:github.com/nicobailon/visual-explainer",
    "git:github.com/nicobailon/pi-intercom",
    "git:github.com/nicobailon/pi-boomerang",
    "git:github.com/nicobailon/pi-interactive-shell",
    "git:git@github.com:nicobailon/pi-subagents.git",
    "npm:@juicesharp/rpiv-todo"
  ],
  "npmCommand": ["bun"],
  "compaction": {
    "enabled": true
  },
  "terminal": {
    "showTerminalProgress": true
  },
  "collapseChangelog": true,
  "quietStartup": true,
  "enableInstallTelemetry": false,
  "treeFilterMode": "default",
  "theme": "dark"
}
