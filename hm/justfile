[private]
default:
    @just --list --unsorted

## -- Brightness Controls -- ##

# set monitor brightness
bright value:
    @ddcutil setvcp 10 {{ value }}

# increase monitor brightness
bright-up amount="5":
    @ddcutil setvcp 10 + {{ amount }}

# decrease monitor brightness
bright-down amount="5":
    @ddcutil setvcp 10 - {{ amount }}

## -- Hardware RGB -- ##

# apply openrgb permissions until next boot (NixOS installs them declaratively)
[linux]
openrgb-setup:
    sudo mkdir -p /run/udev/rules.d
    sudo "$(command -v openrgb)" --generate-udev-rules /run/udev/rules.d/60-openrgb.rules
    sudo udevadm control --reload-rules
    sudo udevadm trigger
    sudo udevadm settle

# save current RGB state as the startup profile
openrgb-save:
    openrgb --save-profile default

mobo-off:
    openrgb --device "${OPENRGB_MOBO:?Motherboard RGB device not configured}" --mode off

mobo-on:
    openrgb --device "${OPENRGB_MOBO:?Motherboard RGB device not configured}" --mode rainbow

mobo:
    #!/usr/bin/env bash
    choice=$(printf '%s\n' \
      'off      --mode off' \
      'rainbow  --mode rainbow' \
      'red-dim  --mode static --color 110000' \
      'red      --mode static --color FF0000' \
      | fzf --with-nth=1 --prompt='Motherboard RGB ❯ ')

    [[ -n "$choice" ]] && openrgb --device "${OPENRGB_MOBO:?Motherboard RGB device not configured}" ${choice#* }

gpu-off:
    openrgb --device "${OPENRGB_GPU:?GPU RGB device not configured}" --mode off

gpu-on:
    openrgb --device "${OPENRGB_GPU:?GPU RGB device not configured}" --mode rainbow

gpu-gradient:
    openrgb --device "${OPENRGB_GPU:?GPU RGB device not configured}" --mode direct --color FF0000,00FF00,0000FF,FFFFFF

gpu-red:
    openrgb --device "${OPENRGB_GPU:?GPU RGB device not configured}" --mode direct --color 110000

gpu:
    #!/usr/bin/env bash
    choice=$(printf '%s\n' \
      'off      --mode off' \
      'rainbow  --mode rainbow' \
      'gradient --mode direct --color FF0000,00FF00,0000FF,FFFFFF' \
      'red-dim  --mode direct --color 110000' \
      'red      --mode direct --color FF0000' \
      | fzf --with-nth=1 --prompt='GPU RGB ❯ ')

    [[ -n "$choice" ]] && openrgb --device "${OPENRGB_GPU:?GPU RGB device not configured}" ${choice#* }

## -- Utils -- ##

# get nix hash for nvidia driver
nvidia-hash:
    @v=$(nvidia-smi --query-gpu=driver_version --format=csv,noheader | head -n1 | xargs); a=$(uname -m); h=$(nix store prefetch-file --json "https://download.nvidia.com/XFree86/Linux-${a}/${v}/NVIDIA-Linux-${a}-${v}.run" | jq -r '.hash'); printf '%s\n%s\n' "$v" "$h"

