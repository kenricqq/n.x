[private]
default:
    @just --list --unsorted

## -- Brightness Controls -- ##

# set monitor brightness
bright value:
    @ddcutil setvcp 10 {{ value }}

# increase monitor brightness
bright-up amount="5":
    @ddcutil setvcp 10 + {{ amount }}

# decrease monitor brightness
bright-down amount="5":
    @ddcutil setvcp 10 - {{ amount }}

## -- Hardware RGB -- ##

# openrgb permissions
openrgb-setup:
    sudo mkdir -p /etc/udev/rules.d
    sudo "$(command -v openrgb)" --generate-udev-rules /etc/udev/rules.d/60-openrgb.rules

    pkg="$(dirname "$(dirname "$(readlink -f "$(command -v openrgb)")")")" &&
    sudo install -Dm644 \
    "$pkg/lib/udev/rules.d/60-openrgb.rules" \
    /etc/udev/rules.d/60-openrgb.rules &&

    sudo udevadm control --reload-rules &&
    sudo udevadm trigger

mobo-off:
    openrgb --device 1 --mode off

mobo-on:
    openrgb --device 1 --mode rainbow

mobo:
    #!/usr/bin/env bash
    choice=$(printf '%s\n' \
      'off      --mode off' \
      'rainbow  --mode rainbow' \
      'red-dim  --mode static --color 110000' \
      'red      --mode static --color FF0000' \
      | fzf --with-nth=1 --prompt='GPU RGB ❯ ')

    [[ -n "$choice" ]] && openrgb --device 1 ${choice#* }

gpu-off:
    openrgb --device 0 --mode off

gpu-on:
    openrgb --device 0 --mode rainbow

gpu-gradient:
    openrgb --device 0 --mode direct --color FF0000,00FF00,0000FF,FFFFFF

gpu-red:
    openrgb --device 0 --mode direct --color 110000

gpu:
    #!/usr/bin/env bash
    choice=$(printf '%s\n' \
      'off      --mode off' \
      'rainbow  --mode rainbow' \
      'gradient --mode direct --color FF0000,00FF00,0000FF,FFFFFF' \
      'red-dim  --mode direct --color 110000' \
      'red      --mode direct --color FF0000' \
      | fzf --with-nth=1 --prompt='GPU RGB ❯ ')

    [[ -n "$choice" ]] && openrgb --device 0 ${choice#* }

## -- Utils -- ##

# get nix hash for nvidia driver
nvidia-hash:
    @v=$(nvidia-smi --query-gpu=driver_version --format=csv,noheader | head -n1 | xargs); a=$(uname -m); h=$(nix store prefetch-file --json "https://download.nvidia.com/XFree86/Linux-${a}/${v}/NVIDIA-Linux-${a}-${v}.run" | jq -r '.hash'); printf '%s\n%s\n' "$v" "$h"

