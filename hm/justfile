# reclaim iNiR memory
qs-reset:
    inir restart

## -- Backup / Sync -- ##

# Syncthing status
sync-stat:
    systemctl --user status syncthing

# Syncthing restart
sync-restart:
    systemctl --user restart syncthing

# Restic backup
backup:
    @echo "Starting restic backup..."
    # restic...

## -- Cleaning -- ##

# clean pacman cache
pac-clean:
    sudo paccache -r
